# --------------------
# Rust (Backend)
# --------------------
/backend/target/
/backend/Cargo.lock     # ✅ This is the correct lock file name
**/*.rs.bk
**/*.rs~

# VS Code Debug/LLDB configs (keep only if not shared)
/backend/.vscode/launch.json
/backend/.vscode/tasks.json

# --------------------
# Node.js / Frontend (Vite + React)
/frontend/node_modules/
/frontend/dist/
/frontend/.cache/
/frontend/.vite/
/frontend/.turbo/      # ✅ For TurboRepo/Vite monorepo if ever used
/frontend/package-lock.json.backup

# --------------------
# IDE Files (global)
/.vscode/               # ✅ At root
.idea/
/*.code-workspace       # ✅ All workspace files in root
*.swp
*~

# --------------------
# OS / Misc Files
# --------------------
.DS_Store
Thumbs.db

# --------------------
# Logs
# --------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --------------------
# Environment Files
# --------------------
.env
.env.*
/frontend/.env.local
/backend/.env.local
target/debug/
/target/
target/.rustc_info.json
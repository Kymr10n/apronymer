{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend + Run Frontend",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=apronymer"],
        "filter": {
          "name": "apronymer",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "Run Frontend",
      "terminal": "integrated"
    },
    {
      "name": "Debug Backend Only",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=apronymer"],
        "filter": {
          "name": "apronymer",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "terminal": "integrated"
    }
  ]
}
